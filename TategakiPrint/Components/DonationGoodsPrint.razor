            min-height: 0 !important;
            background-color: transparent !important;
        }
        .honochou-card.is-selected { background-color: transparent !important; outline: none !important; }

        .debug-box-name { background-color: transparent !important; border: none !important; }
        .debug-box-goods-wrapper { background-color: transparent !important; border: none !important; }
        .debug-box-pair { background-color: transparent !important; border: none !important; }
    }
</style>

@code {
    private const string LocalStorageKey = "TategakiPrint_DonationGoods_Settings_v2";
    private const string DefaultFont = "\"HG行書体\", \"HGP行書体\", \"Kaiti SC\", \"STKaiti\", \"Yu Mincho\", serif";
    private static readonly char[] NameSeparators = new[] { '/', '／', '\r', '\n' };

    private bool showAdvancedSettings = false;
    private bool showExcelImport = false;

    public class GoodsGroup
    {
        public string Name { get; set; } = string.Empty;
        public int SortKey { get; set; }
        public List<DonationGoodsItem> Items { get; set; } = new();
    }

    public class PrintableGoodsEntry
    {
        public string Id { get; set; } = Guid.NewGuid().ToString();
        public string PersistentKey { get; set; } = string.Empty;
        public GoodsGroup? Group { get; set; }
        public bool IsSpacer { get; set; }
    }

    private DonationGoodsPrintSettings Settings { get; set; } = new()
    {
        SelectedFont = DefaultFont
    };

    private List<GoodsGroup> GroupedItems { get; set; } = new();
    private List<List<PrintableGoodsEntry>> PagedPages { get; set; } = new();
    private string? SelectedItemId;

    private string DynamicCssVariables =>
        $"--print-font: {Settings.SelectedFont}; " +
        $"--name-size: {Settings.NameFontSize}rem; " +
        $"--amount-size: {Settings.AmountFontSize}rem; " +
        $"--single-flex: {Settings.SingleLineWidth}; " +
        $"--multi-flex: {Settings.MultiLineWidth}; " +
        $"--spacer-flex: {Settings.SpacerWidth}; " +
        $"--line-gap: {Settings.LineGap}em; " +
        $"--goods-item-gap: {Settings.GoodsItemGap}rem; " +
        $"--name-top-offset: {Settings.NameTopOffset}px; " +
        $"--amount-top-offset: {Settings.AmountTopOffset}px;";

    private bool IsSelectedSpacer
    {
        get
        {
            if (string.IsNullOrEmpty(SelectedItemId)) return false;
            return PagedPages.SelectMany(p => p).Any(i => i.IsSpacer && i.Id == SelectedItemId);
        }
    }

    protected override void OnInitialized()
    {
        if (GoodsState != null)
        {
            GoodsState.OnChange += OnStateChanged;
            if (GoodsState.Items == null || !GoodsState.Items.Any())
            {
                showExcelImport = true;
            }
        }
        ResetPages();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadSettingsAsync();
            ResetPages();
            StateHasChanged();
        }
    }

    private void OnStateChanged()
    {
        ResetPages();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (GoodsState != null)
        {
            GoodsState.OnChange -= OnStateChanged;
        }
    }

    private void ToggleAdvancedSettings()
    {
        showAdvancedSettings = !showAdvancedSettings;
        if (showAdvancedSettings)
        {
            showExcelImport = false;
        }
    }

    private void ToggleExcelImportPanel()
    {
        showExcelImport = !showExcelImport;
        if (showExcelImport)
        {
            showAdvancedSettings = false;
        }
    }

    #region ファイル・シート制御

    private async Task OnExcelFileSelected(InputFileChangeEventArgs e)
    {
        using var stream = e.File.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
        await GoodsState.SetFileAsync(stream, JS, e.File.Name);
        StateHasChanged();
    }

    private async Task OnExcelSheetChangedAsync(ChangeEventArgs e)
    {
        string newSheet = e.Value?.ToString() ?? string.Empty;
        if (!string.IsNullOrEmpty(newSheet))
        {
            await GoodsState.ChangeSheetNameAsync(newSheet, JS);
        }
    }

    private async Task LoadSelectedExcelSheet()
    {
        await GoodsState.LoadSelectedSheetAsync(JS);
        if (string.IsNullOrEmpty(GoodsState.ErrorMessage))
        {
            showExcelImport = false;
        }
        StateHasChanged();
    }

    #endregion

    private void SelectItem(string id) => SelectedItemId = id;

    private void RemoveSelectedSpacer()
    {
        if (string.IsNullOrEmpty(SelectedItemId)) return;

        foreach (var page in PagedPages)
        {
            var targetSpacer = page.FirstOrDefault(i => i.IsSpacer && i.Id == SelectedItemId);
            if (targetSpacer != null)
            {
                page.Remove(targetSpacer);
                CleanUpEmptyPages();
                SelectedItemId = null;
                StateHasChanged();
                break;
            }
        }
    }

    private string GetCardWidthStyle(bool isMultiLine, int itemCount)
    {
        double flexMultiplier = isMultiLine ? Settings.MultiLineWidth : Settings.SingleLineWidth;
        int baseWidth = (int)(flexMultiplier * 48);
        int extraWidth = (itemCount > 1) ? (itemCount - 1) * 35 : 0;
        int totalWidth = baseWidth + extraWidth;

        return $"flex: 0 0 {totalWidth}px;";
    }

    private List<int> GetCurrentPageEntryCounts()
    {
        return PagedPages
            .Select(page => page.Count(entry => !entry.IsSpacer))
            .Where(count => count > 0)
            .ToList();
    }

    private void ResetPages()
    {
        PagedPages = new List<List<PrintableGoodsEntry>>();
        GroupedItems = new List<GoodsGroup>();

        if (GoodsState?.Items == null || !GoodsState.Items.Any()) return;

        var groups = GoodsState.Items
            .GroupBy(x => new { x.SortKey, x.Name })
            .Select(g => new GoodsGroup
            {
                SortKey = g.Key.SortKey,
                Name = g.Key.Name ?? string.Empty,
                Items = g.ToList()
            })
            .ToList();

        GroupedItems = groups;

        var orderedGroups = groups.ToList();

        var pageEntryCounts = (Settings.PageEntryCounts ?? new List<int>())
            .Where(count => count > 0)
            .ToList();

        var currentPage = new List<PrintableGoodsEntry>();
        double currentWidthSum = 0;
        double effectiveMax = Settings.MaxPageWidthUnits - 0.05;
        int pageEntryIndex = 0;

        foreach (var group in orderedGroups)
        {
            double baseWidth = IsMultiLine(group) ? Settings.MultiLineWidth : Settings.SingleLineWidth;
            double extraWidth = (group.Items.Count > 1) ? (group.Items.Count - 1) * 0.7 : 0;
            double totalWidth = baseWidth + extraWidth;
            bool shouldBreakPage = currentPage.Any() && pageEntryCounts.Any() && pageEntryIndex >= pageEntryCounts[0];

            if (shouldBreakPage)
            {
                PagedPages.Add(currentPage);
                currentPage = new List<PrintableGoodsEntry>();
                currentWidthSum = 0;
                pageEntryIndex = 0;
                if (pageEntryCounts.Count > 1)
                {
                    pageEntryCounts.RemoveAt(0);
                }
            }

            if (currentWidthSum + totalWidth > effectiveMax && currentPage.Any())
            {
                PagedPages.Add(currentPage);
                currentPage = new List<PrintableGoodsEntry>();
                currentWidthSum = 0;
            }

            currentPage.Add(new PrintableGoodsEntry
            {
                Id = $"entry-{group.Items.FirstOrDefault()?.Id ?? Guid.NewGuid().ToString()}",
                PersistentKey = group.Items.FirstOrDefault()?.Id ?? Guid.NewGuid().ToString(),
                Group = group,
                IsSpacer = false
            });

            currentWidthSum += totalWidth;
            pageEntryIndex++;
        }

        if (currentPage.Any())
        {
            PagedPages.Add(currentPage);
        }

        if (GoodsState.Items.Any())
        {
            var firstEntry = PagedPages.FirstOrDefault()?.FirstOrDefault();
            if (firstEntry != null)
            {
                SelectedItemId = firstEntry.Id;
            }
        }
    }

    private string FormatQuantityToKanji(int quantity)
    {
        if (quantity < 0) return quantity.ToString();

        string[] kanjiDigits = { "〇", "一", "二", "三", "四", "五", "六", "七", "八", "九", "十" };
        if (quantity <= 10)
        {
            return kanjiDigits[quantity];
        }
        else if (quantity < 100)
        {
            int tens = quantity / 10;
            int ones = quantity % 10;
            
            string tensStr = (tens == 1) ? "十" : kanjiDigits[tens] + "十";
            string onesStr = (ones == 0) ? "" : kanjiDigits[ones];
            
            return tensStr + onesStr;
        }

        return quantity.ToString();
    }

    private bool IsMultiLine(GoodsGroup group)
    {
        if (group == null) return false;

        bool hasMultiName = !string.IsNullOrEmpty(group.Name) && group.Name.IndexOfAny(NameSeparators) >= 0;
        bool hasMultipleItems = group.Items != null && group.Items.Count > 1;

        return hasMultiName || hasMultipleItems;
    }

    private string FormatVerticalName(string input)
    {
        if (string.IsNullOrWhiteSpace(input)) return string.Empty;

        var parts = input.Split(NameSeparators, StringSplitOptions.RemoveEmptyEntries)
                         .Select(p => p.Trim())
                         .Where(p => !string.IsNullOrEmpty(p))
                         .ToArray();

        if (parts.Length == 0) return string.Empty;

        var sb = new System.Text.StringBuilder();

        foreach (string rawPart in parts)
        {
            string part = rawPart;
            if (!part.EndsWith("様") && !part.EndsWith("殿"))
            {
                part += "様";
            }

            string processed = ProcessSegment(part);
            sb.Append($"<div class=\"v-line\">{processed}</div>");
        }

        return sb.ToString();
    }

    private string ProcessSegment(string segment)
    {
        if (string.IsNullOrEmpty(segment)) return string.Empty;

        var sb = new System.Text.StringBuilder();

        foreach (char c in segment)
        {
            if (c == '(') { sb.Append('（'); continue; }
            if (c == ')') { sb.Append('）'); continue; }

            if ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z'))
            {
                char fullWidth = (char)(c + 0xfee0);
                sb.Append(fullWidth);
            }
            else if (c == '\u3000')
            {
                sb.Append('\u0020');
            }
            else
            {
                sb.Append(System.Net.WebUtility.HtmlEncode(c.ToString()));
            }
        }

        return sb.ToString();
    }

    #region 手動ページ移動処理

    private (int pageIndex, int itemIndex)? GetSelectedItemPosition()
    {
        if (string.IsNullOrEmpty(SelectedItemId)) return null;
        for (int p = 0; p < PagedPages.Count; p++)
        {
            int idx = PagedPages[p].FindIndex(i => i.Id == SelectedItemId);
            if (idx >= 0) return (p, idx);
        }
        return null;
    }

    private bool CanMoveToNext => GetSelectedItemPosition().HasValue;
    private bool CanMoveToPrev => GetSelectedItemPosition() is { pageIndex: > 0 };

    private void MoveSelectedAndNextToNextPage()
    {
        var pos = GetSelectedItemPosition();
        if (!pos.HasValue) return;
        int pageIdx = pos.Value.pageIndex;
        int itemIdx = pos.Value.itemIndex;

        var currentPage = PagedPages[pageIdx];
        if (pageIdx + 1 >= PagedPages.Count) PagedPages.Add(new List<PrintableGoodsEntry>());

        var itemsToMove = currentPage.Skip(itemIdx).ToList();
        currentPage.RemoveRange(itemIdx, itemsToMove.Count);
        PagedPages[pageIdx + 1].InsertRange(0, itemsToMove);

        CleanUpEmptyPages();
    }

    private void MoveSelectedAndPrevToPrevPage()
    {
        var pos = GetSelectedItemPosition();
        if (!pos.HasValue || pos.Value.pageIndex <= 0) return;
        int pageIdx = pos.Value.pageIndex;
        int itemIdx = pos.Value.itemIndex;

        var currentPage = PagedPages[pageIdx];
        var itemsToMove = currentPage.Take(itemIdx + 1).ToList();
        currentPage.RemoveRange(0, itemsToMove.Count);
        PagedPages[pageIdx - 1].AddRange(itemsToMove);

        CleanUpEmptyPages();
    }

    private void CleanUpEmptyPages()
    {
        for (int i = PagedPages.Count - 1; i >= 0; i--)
        {
            if (!PagedPages[i].Any(x => !x.IsSpacer) && PagedPages.Count > 1)
            {
                PagedPages.RemoveAt(i);
            }
        }
    }

    #endregion

    #region localStorage Persistence & Export/Import Methods

    private async Task LoadSettingsAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string>("localStorage.getItem", LocalStorageKey);
            if (!string.IsNullOrWhiteSpace(json))
            {
                var loaded = JsonSerializer.Deserialize<DonationGoodsPrintSettings>(json);
                if (loaded != null)
                {
                    Settings = loaded;
                    if (string.IsNullOrWhiteSpace(Settings.SelectedFont)) Settings.SelectedFont = DefaultFont;
                }
            }
        }
        catch { }
    }

    private async Task SaveSettingsAsync()
    {
        try
        {
            Settings.PageEntryCounts = GetCurrentPageEntryCounts();
            var json = JsonSerializer.Serialize(Settings);
            await JS.InvokeVoidAsync("localStorage.setItem", LocalStorageKey, json);
        }
        catch { }
    }

    private async Task ResetSettingsToDefaultAsync()
    {
        Settings = new DonationGoodsPrintSettings { SelectedFont = DefaultFont };
        await JS.InvokeVoidAsync("localStorage.removeItem", LocalStorageKey);
        ResetPages();
    }

    private async Task ExportSettingsAsync()
    {
        Settings.PageEntryCounts = GetCurrentPageEntryCounts();
        var json = JsonSerializer.Serialize(Settings, new JsonSerializerOptions { WriteIndented = true });
        var fileName = $"寄付品縦書き設定_{DateTime.Now:yyyyMMdd_HHmmss}.json";
        
        var bytes = System.Text.Encoding.UTF8.GetBytes(json);
        var base64 = Convert.ToBase64String(bytes);
        
        var jsCode = $@"
            const link = document.createElement('a');
            link.download = '{fileName}';
            link.href = 'data:application/json;base64,' + '{base64}';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        ";
        await JS.InvokeVoidAsync("eval", jsCode);
    }

    private async Task ImportSettingsAsync(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file != null)
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024);
                using var reader = new System.IO.StreamReader(stream);
                var json = await reader.ReadToEndAsync();

                var loaded = JsonSerializer.Deserialize<DonationGoodsPrintSettings>(json);
                if (loaded != null)
                {
                    Settings = loaded;
                    if (string.IsNullOrWhiteSpace(Settings.SelectedFont)) Settings.SelectedFont = DefaultFont;
                    if (Settings.PageEntryCounts == null || !Settings.PageEntryCounts.Any())
                    {
                        Settings.PageEntryCounts = GetCurrentPageEntryCounts();
                    }
                    else
                    {
                        Settings.PageEntryCounts = Settings.PageEntryCounts
                            .Where(count => count > 0)
                            .ToList();
                    }
                    var importJson = JsonSerializer.Serialize(Settings);
                    await JS.InvokeVoidAsync("localStorage.setItem", LocalStorageKey, importJson);
                    ResetPages();
                    StateHasChanged();
                }
            }
        }
        catch { }
    }

    #endregion

    #region Input Event Handlers

    private async Task OnFontChangedAsync(ChangeEventArgs e)
    {
        Settings.SelectedFont = e.Value?.ToString() ?? DefaultFont;
        await SaveSettingsAsync();
    }

    private async Task OnMaxPageWidthInputAsync(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out double val))
        {
            Settings.MaxPageWidthUnits = val;
            await SaveSettingsAsync();
