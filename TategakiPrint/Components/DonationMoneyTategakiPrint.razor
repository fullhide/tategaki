    private async Task OnSpacerWidthInputAsync(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out double val))
        {
            Settings.SpacerWidth = val;
            await SaveSettingsAsync();
            ResetPages();
        }
    }

    #endregion

    private List<string> GetCurrentPageEntryPersistentKeys()
    {
        return PagedPages
            .SelectMany(page => page)
            .Where(entry => !entry.IsSpacer && !string.IsNullOrWhiteSpace(entry.PersistentKey))
            .Select(entry => entry.PersistentKey)
            .ToList();
    }

    private void ResetPages()
    {
        PagedPages = new List<List<PrintableEntry>>();
        if (State.Items == null || !State.Items.Any()) return;

        var currentPage = new List<PrintableEntry>();
        double currentWidthSum = 0;
        double effectiveMax = Settings.MaxPageWidthUnits - 0.05;

        decimal? previousAmount = null;

        foreach (var item in State.Items)
        {
            if (previousAmount.HasValue && previousAmount.Value != item.Amount)
            {
                double spacerWidth = Settings.SpacerWidth;

                if (spacerWidth > 0)
                {
                    if (currentWidthSum + spacerWidth > effectiveMax && currentPage.Any())
                    {
                        PagedPages.Add(currentPage);
                        currentPage = new List<PrintableEntry>();
                        currentWidthSum = 0;
                    }
                    else
                    {
                        currentPage.Add(new PrintableEntry { IsSpacer = true });
                        currentWidthSum += spacerWidth;
                    }
                }
            }

            previousAmount = item.Amount;

            double itemWidth = IsMultiLine(item.Name) ? Settings.MultiLineWidth : Settings.SingleLineWidth;

            if (currentWidthSum + itemWidth > effectiveMax && currentPage.Any())
            {
                PagedPages.Add(currentPage);
                currentPage = new List<PrintableEntry>();
                currentWidthSum = 0;
            }

            currentPage.Add(new PrintableEntry { Id = $"entry-{item.Id}", PersistentKey = $"{item.Id}", Item = item, IsSpacer = false });
            currentWidthSum += itemWidth;
        }

        if (currentPage.Any())
        {
            PagedPages.Add(currentPage);
        }

        if (State.Items.Any())
        {
            var firstEntry = PagedPages.FirstOrDefault()?.FirstOrDefault();
            if (firstEntry != null)
            {
                SelectedItemId = firstEntry.Id;
            }
        }
    }

    private void GoBack() => State.ShowEdit();
    private async Task Print() => await JS.InvokeVoidAsync("print");

    private bool IsMultiLine(string input)
    {
        if (string.IsNullOrWhiteSpace(input)) return false;
        return input.Contains('/') || input.Contains('／');
    }

    private string FormatVerticalName(string input)
    {
        if (string.IsNullOrWhiteSpace(input)) return string.Empty;

        string clean = input.Trim();
        if (clean.EndsWith("様")) clean = clean.Substring(0, clean.Length - 1).Trim();
        if (clean.EndsWith("殿")) clean = clean.Substring(0, clean.Length - 1).Trim();

        var parts = clean.Split(new[] { '/', '／' }, StringSplitOptions.RemoveEmptyEntries);
        var sb = new System.Text.StringBuilder();

        for (int i = 0; i < parts.Length; i++)
        {
            string processed = ProcessSegment(parts[i].Trim());
            if (i == parts.Length - 1)
            {
                processed += " 様";
            }
            sb.Append($"<div class=\"v-line\">{processed}</div>");
        }

        return sb.ToString();
    }

    private string ProcessSegment(string segment)
    {
        if (string.IsNullOrEmpty(segment)) return string.Empty;

        var sb = new System.Text.StringBuilder();

        foreach (char c in segment)
        {
            if (c == '(') { sb.Append('（'); continue; }
            if (c == ')') { sb.Append('）'); continue; }

            if ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z'))
            {
                char fullWidth = (char)(c + 0xfee0);
                sb.Append(fullWidth);
            }
            else if (c == '\u3000')
            {
                sb.Append('\u0020');
            }
            else
            {
                sb.Append(System.Net.WebUtility.HtmlEncode(c.ToString()));
            }
        }

        return sb.ToString();
    }

    private string FormatAmountToKanji(decimal amount)
    {
        long val = (long)amount;

        if (val >= 10000)
        {
            long man = val / 10000;
            long remainder = val % 10000;

            string manStr = man switch
            {
                1 => "壱萬",
                2 => "弐萬",
                3 => "参萬",
                5 => "伍萬",
                10 => "拾萬",
                _ => ConvertToDaiji(man) + "萬"
            };

            if (remainder == 0) return manStr;

            return manStr + ConvertToNormalKanji(remainder);
        }

        return ConvertToNormalKanji(val);
    }

    private string ConvertToNormalKanji(long number)
    {
        if (number == 0) return "零";

        string[] units = { "", "十", "百", "千" };
        string[] digits = { "", "一", "二", "三", "四", "五", "六", "七", "八", "九" };

        var sb = new System.Text.StringBuilder();
        string numStr = number.ToString();
        int len = numStr.Length;

        for (int i = 0; i < len; i++)
        {
            int d = numStr[i] - '0';
            int unitIdx = len - 1 - i;

            if (d != 0)
            {
                sb.Append(digits[d]);
                if (unitIdx > 0)
                {
                    sb.Append(units[unitIdx]);
                }
            }
        }

        return sb.ToString();
    }

    private string ConvertToDaiji(long number)
    {
        string[] daijiDigits = { "", "壱", "弐", "参", "四", "伍", "六", "七", "八", "九" };
        var sb = new System.Text.StringBuilder();
        foreach (char c in number.ToString())
        {
            int d = c - '0';
            sb.Append(daijiDigits[d]);
        }
        return sb.ToString();
    }
}