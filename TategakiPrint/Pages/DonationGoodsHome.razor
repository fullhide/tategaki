@page "/goods"
@using TategakiPrint.Services
@using TategakiPrint.Components
@inject DonationGoodsState GoodsState
@implements IDisposable

<PageTitle>寄付品一覧 縦書き印刷</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
        <h2 class="m-0">寄付品一覧 縦書き印刷</h2>
        @if (!string.IsNullOrWhiteSpace(GoodsState.LastLoadedWorkbookName) &&
             !string.IsNullOrWhiteSpace(GoodsState.LastLoadedSheetName) &&
             GoodsState.LastLoadedAt.HasValue)
        {
            <div class="small text-secondary">
                <span class="fw-semibold text-muted me-2">最終読込情報</span>
                <span class="fw-semibold">@GoodsState.LastLoadedWorkbookName</span>
                <span class="mx-2">|</span>
                <span>シート: @GoodsState.LastLoadedSheetName</span>
                <span class="mx-2">|</span>
                <span>読込日時: @GoodsState.LastLoadedAt.Value.ToString("yyyy/MM/dd HH:mm:ss")</span>
            </div>
        }
    </div>

    <!-- タブ風ナビゲーション（印刷 / 編集 切り替え） -->
    <div class="d-flex justify-content-center mb-4">
        <div class="btn-group" role="group">
            <button type="button" 
                    class="btn @(GoodsState.CurrentView == ViewMode.Print ? "btn-primary font-weight-bold" : "btn-outline-secondary")"
                    @onclick="GoodsState.ShowPrint">
                縦書き印刷
            </button>
            <button type="button" 
                    class="btn @(GoodsState.CurrentView == ViewMode.Edit ? "btn-primary font-weight-bold" : "btn-outline-secondary")"
                    @onclick="GoodsState.ShowEdit">
                データ確認・編集
            </button>
        </div>
    </div>

    <!-- コンテンツ表示切り替え -->
    @switch (GoodsState.CurrentView)
    {
        case ViewMode.Edit:
            <div class="alert alert-info text-center my-5">
                寄付品データの確認・編集画面は準備中です。
            </div>
            @* DonationGoodsEdit.razor 作成後に下記コメント解除 *@
            @* <DonationGoodsEdit /> *@
            break;

        case ViewMode.Print:
            <DonationGoodsPrint />
            break;

        default:
            <DonationGoodsPrint />
            break;
    }
</div>

@code {
    protected override void OnInitialized()
    {
        GoodsState.OnChange += OnStateChanged;
    }

    private void OnStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        GoodsState.OnChange -= OnStateChanged;
    }
}