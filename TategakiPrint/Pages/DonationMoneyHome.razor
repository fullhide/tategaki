@page "/"
@using TategakiPrint.Services
@using TategakiPrint.Components
@inject DonationMoneyState State
@implements IDisposable

<PageTitle>寄付金一覧 縦書き印刷</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
        <h2 class="m-0">寄付金一覧 縦書き印刷</h2>
        @if (!string.IsNullOrWhiteSpace(State.LastLoadedWorkbookName) &&
             !string.IsNullOrWhiteSpace(State.LastLoadedSheetName) &&
             State.LastLoadedAt.HasValue)
        {
            <div class="small text-secondary">
                <span class="fw-semibold text-muted me-2">最終読込情報</span>
                <span class="fw-semibold">@State.LastLoadedWorkbookName</span>
                <span class="mx-2">|</span>
                <span>シート: @State.LastLoadedSheetName</span>
                <span class="mx-2">|</span>
                <span>読込日時: @State.LastLoadedAt.Value.ToString("yyyy/MM/dd HH:mm:ss")</span>
            </div>
        }
    </div>

    <!-- タブ風ナビゲーション（印刷 / 編集 切り替え） -->
    <div class="d-flex justify-content-center mb-4">
        <div class="btn-group" role="group">
            <button type="button" 
                    class="btn @(State.CurrentView == ViewMode.Print ? "btn-primary font-weight-bold" : "btn-outline-secondary")"
                    @onclick="State.ShowPrint">
                縦書き印刷
            </button>
            <button type="button" 
                    class="btn @(State.CurrentView == ViewMode.Edit ? "btn-primary font-weight-bold" : "btn-outline-secondary")"
                    @onclick="State.ShowEdit">
                データ確認・編集
            </button>
        </div>
    </div>

    <!-- コンテンツ表示切り替え -->
    @switch (State.CurrentView)
    {
        case ViewMode.Edit:
            <DonationMoneyDataEdit />
            break;
        case ViewMode.Print:
            <DonationMoneyPrint />
            break;
        default:
            <DonationMoneyPrint />
            break;
    }
</div>

@code {
    protected override void OnInitialized()
    {
        State.OnChange += OnStateChanged;
    }

    private void OnStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        State.OnChange -= OnStateChanged;
    }
}